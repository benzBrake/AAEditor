# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.php text eol=lf
*.js text eol=lf
*.scss text eol=lf
*.css text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# Declare files that will always have CRLF line endings on checkout
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.eot binary
*.ttf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.phar binary

# Build artifacts
assets/dist/* binary
pack/* binary
